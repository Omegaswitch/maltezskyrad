      "css": ".ds-nav{display:flex;background:#454545}.ds-nav a{flex:1 1 auto;text-align:center;padding:13px 10px;color:#fff;text-decoration:none;font:.8rem 'Asap',Arial,sans-serif;letter-spacing:.07em;text-transform:uppercase;border-right:1px solid rgba(255,255,255,.13);transition:background 160ms}.ds-nav a:last-child{border-right:0}.ds-nav a:hover,.ds-nav a:focus-visible{background:#383838;outline:none}.ds-nav a[aria-current]{background:#2f2f2f;box-shadow:inset 0 -3px 0 #e31a18}"
